NODE_ENV=production
LOG_LEVEL='errors-only' 
#'all', 'info', 'errors-only', 'none'

# Postgres connection details
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=metamcp_user
POSTGRES_PASSWORD=m3t4mcp
POSTGRES_DB=metamcp_db
POSTGRES_OPENWEBUI_DB=openwebui_db
POSTGRES_OPENWEBUI_VECTORS_DB=openwebui_vectors

# Database configuration (composed from above vars)
PGDB_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Ollama
OLLAMA_BASE_URL="http://ollama:11434"
USE_OLLAMA_DOCKER=false
# APP_URL=${APP_URL:-http://app:12008}

APP_URL="http://app:12008"
PG_URL="http://postgres:5432"
USE_CUDA_DOCKER=true
DOCKER=true
# USE_OLLAMA=false # Force disable Ollama integration (for testing without Ollama or if using a different LLM provider)
# Embedding / reranking
host-gateway="ollama"
RAG_EMBEDDING_MODEL=${RAG_EMBEDDING_MODEL:-nomic-ai/nomic-embed-text-v2-moe}
RAG_RERANKING_MODEL=${RAG_RERANKING_MODEL:-Qwen/Qwen3-Reranker-0.6B}
HF_TOKEN=${HF_TOKEN:-}
# Postgres — main app DB and vector DB are separate
VECTOR_DB=pgvector
DATABASE_URL="postgresql://${POSTGRES_USER:-metamcp_user}:${POSTGRES_PASSWORD:-m3t4mcp}@postgres:5432/${POSTGRES_OPENWEBUI_DB:-openwebui_db}"
PGVECTOR_DB_URL="postgresql://${POSTGRES_USER:-metamcp_user}:${POSTGRES_PASSWORD:-m3t4mcp}@postgres:5432/${POSTGRES_OPENWEBUI_VECTORS_DB:-openwebui_vectors}"
PGVECTOR_CREATE_EXTENSION=false # Set to true if the pgvector extension is not already created in the Postgres container
# Admin bootstrap (change in .env for production)
WEBUI_ADMIN_EMAIL=${WEBUI_ADMIN_EMAIL:-admin@localhost}
WEBUI_ADMIN_PASSWORD=${WEBUI_ADMIN_PASSWORD:-admin}
WEBUI_ADMIN_NAME=${WEBUI_ADMIN_NAME:-admin}