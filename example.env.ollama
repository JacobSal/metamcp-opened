# ══════════════════════════════════════════════════════════════════════════════
# Ollama Configuration - GTX 3080 Ti (12GB) + GTX 1060 (3GB) Optimization
# ══════════════════════════════════════════════════════════════════════════════

# Model Configuration
# Change this to pull a different model on startup (e.g., mistral, llama2, neural-chat)
# Full model list: https://ollama.ai/library
OLLAMA_MODEL=gemma4:e4b

# ──────────────────────────────────────────────────────────────────────────────
# GPU Configuration
# ──────────────────────────────────────────────────────────────────────────────

# CUDA_VISIBLE_DEVICES: Which GPUs to use
# 0 = GTX 3080 Ti (12GB)
# 1 = GTX 1060 (3GB)
# Use both GPUs for load distribution
CUDA_VISIBLE_DEVICES=0,1

# GPU Memory Overhead (in MB)
# Reserves memory for GPU operations, prevents OOM errors during model loading
# 2048 MB (2GB) recommended for high-end RTX 3000-series cards
# This leaves ~10GB for the model on 3080 Ti
OLLAMA_GPU_OVERHEAD=2048

# ──────────────────────────────────────────────────────────────────────────────
# Memory & Performance Optimization
# ──────────────────────────────────────────────────────────────────────────────

# Flash Attention: Enables memory-efficient attention computation
# Reduces VRAM usage by ~30-40% for large context windows
# Highly recommended for gemma4 with extended context
OLLAMA_FLASH_ATTENTION=1

# Parallel Inference Requests: How many requests to process simultaneously
# Higher = better throughput but higher VRAM usage
# gemma4:e4b (~7GB) + KV cache allows 1-2 parallel requests comfortably
# If VRAM issues, reduce to 1
OLLAMA_NUM_PARALLEL=2

# Number of Threads for CPU Context
# Set to your CPU core count for optimal performance
# Modern CPUs: use 12-16 for best balance
OLLAMA_NUM_THREAD=16

# Context Window Length (tokens)
# gemma4 supports up to 32k context
# Larger context = more VRAM for KV cache
# Trade-off: 8192 balances memory and capability
# For aggressive VRAM usage: 4096
# For maximum capability: 16384
OLLAMA_NUM_CTX=8192

# Layer GPU Offload (num_gpu): How many transformer layers to run on GPU
# 999 = offload as many layers as possible to GPU
# Lower values = more CPU, less VRAM
# Leave at 999 for best performance
OLLAMA_LLM_NUM_GPU=999

# Maximum Models to Keep Loaded
# With 12GB VRAM, safely keep 1-2 models loaded
# If you frequently switch models, increase to 3
# Each additional model reduces VRAM available for inference
OLLAMA_MAX_LOADED_MODELS=2

# Model Keep-Alive Duration
# How long to keep a model in memory before unloading
# 5m = 5 minutes (good for multi-model usage)
# 24h = 24 hours (good for single model focus)
OLLAMA_KEEP_ALIVE=5m

# ──────────────────────────────────────────────────────────────────────────────
# Advanced Tuning (Optional)
# ──────────────────────────────────────────────────────────────────────────────

# Enable Debugging/Verbose Output
# Set to 1 for detailed logs (includes memory allocation info)
OLLAMA_DEBUG=0

# Verbose Logging
# Set to true for more detailed runtime logs
OLLAMA_VERBOSE=false

# ──────────────────────────────────────────────────────────────────────────────
# Performance Profiles
# ──────────────────────────────────────────────────────────────────────────────

# PROFILE: Max Throughput (Multiple Requests)
# Uncomment these lines for handling multiple simultaneous requests
# OLLAMA_NUM_PARALLEL=3
# OLLAMA_NUM_CTX=4096
# OLLAMA_KEEP_ALIVE=10m

# PROFILE: Max Quality (Single Request, Extended Context)
# Uncomment these lines for best quality with longer context
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_NUM_CTX=16384
# OLLAMA_KEEP_ALIVE=1h

# PROFILE: Budget Mode (Conservative VRAM)
# Uncomment these lines if you run into VRAM issues
# OLLAMA_NUM_PARALLEL=1
# OLLAMA_NUM_CTX=4096
# OLLAMA_GPU_OVERHEAD=1024
# OLLAMA_KEEP_ALIVE=5m

# ══════════════════════════════════════════════════════════════════════════════
# Open WebUI Configuration (if using Open WebUI with Ollama)
# ══════════════════════════════════════════════════════════════════════════════

# RAG (Retrieval Augmented Generation) Embedding Settings
RAG_EMBEDDING_BATCH_SIZE=16
RAG_EMBEDDING_ENGINE=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text-v2-moe
RAG_RERANKING_MODEL=Qwen/Qwen3-Reranker-0.6B

# Admin bootstrap credentials
WEBUI_ADMIN_EMAIL=admin@localhost
WEBUI_ADMIN_PASSWORD=admin
WEBUI_ADMIN_NAME=admin

# ══════════════════════════════════════════════════════════════════════════════
# VRAM Calculation Reference
# ══════════════════════════════════════════════════════════════════════════════

# gemma4:e4b (7B e4 quantization)
# Model weights: ~3.5-4 GB
# KV cache at 8k context (FP16): ~2-3 GB
# Overhead/buffers: ~1-2 GB
# Total per request: ~6-8 GB
# With 2 parallel: needs ~12-14 GB (why we limit to 2)

# Optimization Tips:
# 1. If VRAM errors occur: reduce OLLAMA_NUM_PARALLEL to 1
# 2. For longer context: set OLLAMA_FLASH_ATTENTION=1 (reduces KV cache ~30%)
# 3. Monitor VRAM: docker exec ollama nvidia-smi
# 4. Check model loading: docker exec ollama ollama list
# 5. Tune context: OLLAMA_NUM_CTX=4096 for tighter constraints
